generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  money        Int      @default(1000)
  role         String   @default("user") // "user" | "admin"
  createdAt    DateTime @default(now())

  characters Character[]
  items      InventoryItem[]
}

model Character {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationality   String
  age           Int
  gender        String
  feature       String
  rarity        String
  secretFeature String?
  specialType   String?
  level         Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([userId, rarity])
}

model InventoryItem {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey  String
  quantity Int    @default(0)

  @@unique([userId, itemKey])
}
